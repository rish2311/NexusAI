# NexusAI — Sprint 1 (₹0 / free tier only)
# Copy to .env and fill in values. Never commit .env.

# --- Gemini free tier (required for live chat) ---
# Get a key at https://ai.google.dev/ — no credit card needed
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Database (Docker Compose defaults) ---
DATABASE_URL=postgresql+asyncpg://nexusai:nexusai@localhost:5432/nexusai

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Auth / JWT ---
JWT_SECRET=change-me-to-a-long-random-string-in-local-dev
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Quotas (per user, daily) ---
DEFAULT_DAILY_REQUEST_QUOTA=50
DEFAULT_DAILY_TOKEN_QUOTA=100000

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=gemini
# Use "mock" for tests / offline: LLM_PROVIDER=mock

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
